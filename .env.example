# Runtime secrets stay here; do not bake them into an image or send them to React.
# Local mode preserves the existing browser workspace. OIDC mode requires login.
APP_AUTH_MODE=local
# Configure these only after registering an OIDC application with your provider.
# APP_BASE_URL=https://rag.example.com
# OIDC_ISSUER=https://your-provider.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Register the exact callback: APP_BASE_URL + /api/auth/callback
# OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# Alternatives: client_secret_post, or none for a public client with PKCE.
# OIDC_SIGNING_ALGORITHM=RS256
# Alternative: ES256 when configured on the provider's application.
AUTH_SESSION_SECONDS=28800

GOOGLE_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
GENERATION_PROVIDER=google
GENERATION_MODEL=gemma-4-26b-a4b-it
# Gemma 4 26B A4B uses the Google API. No Gemini-specific thinking options are sent.
MODEL_TIMEOUT_SECONDS=60
GENERATION_MAX_OUTPUT_TOKENS=2048
# This thinking-budget field applies to supported Gemini 2.5 Flash models only.
GENERATION_THINKING_BUDGET=0
GENERATION_MAX_CONTEXT_CHARS=12000
GENERATION_MAX_IMAGES=3
GENERATION_IMAGE_MAX_DIM=1280

# Judge configuration. This preset intentionally uses the same model throughout.
# Preview is a labelled subset; full evaluates all dataset cases.
EVALUATION_PROVIDER=google
EVALUATION_MODEL=gemma-4-26b-a4b-it
# Optional independent free judge; enable both lines locally when its key is set.
# EVALUATION_PROVIDER=openrouter
# EVALUATION_MODEL=inclusionai/ling-3.2-flash:free
# Alternative: nvidia/nemotron-3.5-super-vl:free
# OpenRouter supports only fixed :free model IDs here, with zero-price routing.
EVALUATION_CONCURRENCY=2
EVALUATION_TIMEOUT=90
# Individual requests have 90 seconds; complete multi-request metrics have 360.
EVALUATION_METRIC_TIMEOUT=360
# Transient provider retries and JSON repair share a bounded request budget.
EVALUATION_MAX_RETRIES=1
EVALUATION_MAX_TOKENS=4096
EVALUATION_REASONING_EFFORT=minimal
EVALUATION_PREVIEW_QUESTIONS=5
EVALUATION_K=5
RETRIEVAL_K=10
RETRIEVAL_TOP_N=3

# Automatic source-grounded questions; defaults reuse the answer generator.
# References are source-checked, with same-model verification explicitly labelled.
SYNTHETIC_GENERATION_PROVIDER=google
SYNTHETIC_GENERATION_MODEL=gemma-4-26b-a4b-it
SYNTHETIC_ALLOW_SAME_MODEL_VERIFICATION=true
SYNTHETIC_GENERATION_TIMEOUT=60
SYNTHETIC_GENERATION_MAX_TOKENS=4096
SYNTHETIC_GENERATION_CONCURRENCY=2
# Retry temporary 5xx drafting failures within the same overall request deadline.
# HTTP 429 quota errors and authentication failures stop without these retries.
SYNTHETIC_MAX_RETRIES=1
SYNTHETIC_RETRY_DELAY_SECONDS=1

# Ingestion uses original text/tables by default, with no LLM summaries.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
INGESTION_BATCH_SIZE=32
# EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# If omitted, reranking uses Cohere when its key exists, otherwise none.
# RERANKER_PROVIDER=cohere
COHERE_RERANK_MODEL=rerank-english-v3.0
RERANK_TIMEOUT_SECONDS=15

# Optional local generation needs a separately running Ollama service/model.
# GENERATION_PROVIDER=ollama
# LOCAL_GENERATION_MODEL=gemma3:4b
# OLLAMA_BASE_URL=http://localhost:11434

# Default: no Tesseract, Poppler, API key, or model download during OCR.
PDF_EXTRACTION_MODE=auto
OCR_BACKEND=rapidocr
OCR_DPI=200
OCR_THREADS=2
OCR_MIN_CONFIDENCE=0.5
OCR_MAX_PIXELS=12000000
PDF_MAX_PAGES=300
PDF_MAX_FILE_MB=50

# Optional legacy hi_res mode: install requirements-hires.txt and external tools.
# PDF_EXTRACTION_MODE=hi_res
# OCR_BACKEND=tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
